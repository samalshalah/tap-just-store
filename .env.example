# --- Database ---
# Local development and drizzle schema pushes can use DATABASE_URL directly.
# In Cloudflare Workers, prefer the HYPERDRIVE binding configured in wrangler.jsonc.
DATABASE_URL=postgres://user:pass@host:5432/dbname

# --- Admin ---
# A single password gates the entire /admin route group.
# Store this as a Cloudflare Worker secret before deploying.
ADMIN_PASSWORD=change-me-before-launch

# --- Public site URL ---
# Used in canonical URLs, sitemap.xml, JSON-LD, and OG image absolute paths.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Cloudflare bindings configured in wrangler.jsonc ---
# MEDIA_BUCKET: R2 bucket for admin-uploaded media.
# NEXT_INC_CACHE_R2_BUCKET: R2 bucket for OpenNext incremental cache.
# HYPERDRIVE: Cloudflare Hyperdrive binding for Postgres.

# --- Optional future integrations ---
# MAILCHIMP_API_KEY=
# MAILCHIMP_DC=
# SENDGRID_API_KEY=
# POSTMARK_SERVER_TOKEN=
